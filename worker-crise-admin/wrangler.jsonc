{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brusque-crise-admin",
  "main": "src/index.js",
  "compatibility_date": "2025-07-01",
  "assets": { "directory": "./public" },
  "kv_namespaces": [{ "binding": "CRISE_KV", "id": "a1bca59ce8f14d2fb50c7551acef4a29" }],
  // ADMIN_SENHA NÃO fica aqui (era placeholder em texto puro = senha padrão pública).
  // Definir como secret: `cd worker-crise-admin && npx wrangler secret put ADMIN_SENHA`.
  // Sem o secret, env.ADMIN_SENHA é undefined e o login é impossível (admin travado = seguro).
  "observability": { "enabled": true }
}
